{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PexliFormation",
  "version": "1.0.0",
  "identifier": "com.pexli.formation",
  "build": {
    "frontendDist": "../src",
    "beforeDevCommand": "",
    "beforeBuildCommand": ""
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "PexliFormation — Rust → SBF Converter",
        "width": 1040,
        "height": 700,
        "minWidth": 860,
        "minHeight": 580,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "publisher": "Pexli Labs",
    "copyright": "© Pexli Labs",
    "category": "DeveloperTool",
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "resources": ["resources/*"],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico",
        "headerImage": "icons/installer-header.bmp",
        "sidebarImage": "icons/installer-sidebar.bmp",
        "installerHooks": "installer-hooks.nsh"
      }
    },
    "shortDescription": "Convert Rust smart contracts to SBF for Pexli v2 — offline.",
    "longDescription": "PexliFormation is an offline desktop app that translates a Rust smart contract into the SBF program format used by the Pexli v2 blockchain. No terminal, no commands — pick a contract and click Convert."
  }
}
